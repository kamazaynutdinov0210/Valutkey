# Normalize line endings; treat these as text
* text=auto eol=lf

# Explicit text types
*.ts        text
*.tsx       text
*.js        text
*.mjs       text
*.json      text
*.md        text
*.css       text
*.html      text
*.yml       text
*.yaml      text
*.svg       text
*.txt       text

# Windows scripts keep CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets
*.png       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.wasm      binary

# Lockfiles: mark as generated for review collapsing
package-lock.json linguist-generated=true

# Test/build artifacts
dist/**               linguist-generated=true
playwright-report/**  linguist-generated=true
test-results/**       linguist-generated=true